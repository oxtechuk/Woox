# =====================================================================
# Wox-Lv Production Environment Configuration Template
# =====================================================================

APP_NAME="Wox WhatsApp"
APP_ENV=production
APP_KEY=  # Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────
# LOGGING (Daily rotation + Sentry)
# ─────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAYS=14

# ─────────────────────────────────────────────────────────────
# DATABASE (Production MySQL 8+)
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wox_production
DB_USERNAME=wox_db_user
DB_PASSWORD=StrongSecureDatabasePasswordHere
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ─────────────────────────────────────────────────────────────
# CACHE, SESSION, QUEUE (Use Redis in Production)
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=wox_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=StrongRedisPasswordHere
REDIS_PORT=6379
CACHE_REDIS_PREFIX_KEY=wox_prod

# ─────────────────────────────────────────────────────────────
# BROADCAST & REVERB (WebSockets for real-time dashboard)
# ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REVERB_APP_ID=wox-prod-app
REVERB_APP_KEY=GenerateStrongRandomReverbKey
REVERB_APP_SECRET=GenerateStrongRandomReverbSecret
REVERB_HOST=api.yourdomain.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─────────────────────────────────────────────────────────────
# CORS & SECURITY
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed domains (your frontend + wordpress store)
CORS_ALLOWED_ORIGINS="https://app.yourdomain.com,https://yourstore.com"
CORS_CREDENTIALS=true

# Rate Limits (Requests per minute)
API_RATE_LIMIT_PER_MINUTE=120
WP_RATE_LIMIT_PER_MINUTE=300

# ─────────────────────────────────────────────────────────────
# EVOLUTION API & BRIDGE (WhatsApp Engine)
# ─────────────────────────────────────────────────────────────
# Master Global API Key (Used by Super Admin)
AUTHENTICATION_API_KEY=GenerateUltraSecureRandomGlobalKey64HexChars
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

SERVER_NAME=wox-prod
SERVER_TYPE=https
SERVER_PORT=8001
SERVER_URL=https://api.yourdomain.com

# Evolution Node.js / Baileys Bridge
EVOLUTION_BRIDGE_URL=http://127.0.0.1:8082
EVOLUTION_BRIDGE_TIMEOUT=30

DEL_INSTANCE=false
QRCODE_LIMIT=30
QRCODE_COLOR=#175197

CONFIG_SESSION_PHONE_CLIENT="Wox WhatsApp"
CONFIG_SESSION_PHONE_NAME=Chrome

# ─────────────────────────────────────────────────────────────
# WEBHOOK SETTINGS
# ─────────────────────────────────────────────────────────────
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_REQUEST_TIMEOUT_MS=30000
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=120
WEBHOOK_RETRY_JITTER_FACTOR=0.2

# ─────────────────────────────────────────────────────────────
# MAIL CONFIGURATION (SMTP)
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@yourdomain.com
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@yourdomain.com"
MAIL_FROM_NAME="Wox Platform"

# ─────────────────────────────────────────────────────────────
# SENTRY & MONITORING
# ─────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

HEALTH_RESULTS_STORE_DRIVER=json
HEALTH_DISK_WARN_PERCENTAGE=75
HEALTH_DISK_FAIL_PERCENTAGE=90

# ─────────────────────────────────────────────────────────────
# BACKUPS (Daily DB + Storage to S3 / Local)
# ─────────────────────────────────────────────────────────────
BACKUP_DESTINATION_DISKS=local
BACKUP_DB_CONNECTIONS=mysql

